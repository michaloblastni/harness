<article class="max-w-none">
    <p class="text-sm font-semibold text-sky-700"><?= h(tr('Harness')) ?></p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900"><?= h(tr('How it works')) ?></h1>
    <p class="mt-4 text-lg text-slate-600"><?= h(tr('How matching works')) ?></p>

    <ol class="mt-8 list-none space-y-8 pl-0">
        <li class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm">
            <div class="flex flex-col gap-4 sm:flex-row sm:gap-5">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-sky-500/10 text-sky-600" aria-hidden="true">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 8.25H3.375m0 0H7.5m0 0v3.75m0-3.75h3.375m-3.375 0h-3.375"/>
                    </svg>
                </div>
                <div class="min-w-0 flex-1">
                    <h2 class="text-lg font-semibold text-slate-900"><?= h(tr('Step 1 — Save the exact line')) ?></h2>
                    <p class="mt-2 text-slate-600"><?= h(tr('Write what you heard, word for word, in the language and spelling you remember. Harness stores it privately with your account only.')) ?></p>
                </div>
            </div>
        </li>
        <li class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm">
            <div class="flex flex-col gap-4 sm:flex-row sm:gap-5">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-violet-500/10 text-violet-600" aria-hidden="true">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
                    </svg>
                </div>
                <div class="min-w-0 flex-1">
                    <h2 class="text-lg font-semibold text-slate-900"><?= h(tr('Step 2 — We look for an identical line')) ?></h2>
                    <p class="mt-2 text-slate-600"><?= h(tr('The service compares your saved text with other accounts. A match means the same characters in the same order—we do not guess or fuzzy-match, so nothing is silently changed.')) ?></p>
                </div>
            </div>
        </li>
        <li class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm">
            <div class="flex flex-col gap-4 sm:flex-row sm:gap-5">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-emerald-500/10 text-emerald-600" aria-hidden="true">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.09 9.09 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/>
                    </svg>
                </div>
                <div class="min-w-0 flex-1">
                    <h2 class="text-lg font-semibold text-slate-900"><?= h(tr('Step 3 — Linked victims (you choose contact)')) ?></h2>
                    <p class="mt-2 text-slate-600"><?= h(tr('If another account saved the same line, they may appear as a linked victim. Email is not shown on a public page; you decide whether to reach out.')) ?></p>
                </div>
            </div>
        </li>
    </ol>

    <div class="mt-10 flex flex-col gap-4 rounded-2xl border border-sky-100 bg-gradient-to-br from-sky-50/90 to-indigo-50/50 p-6 sm:flex-row sm:gap-5">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-indigo-500/15 text-indigo-700" aria-hidden="true">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
            </svg>
        </div>
        <div class="min-w-0 flex-1">
            <h2 class="text-lg font-semibold text-sky-900"><?= h(tr('Safety first')) ?></h2>
            <p class="mt-2 text-slate-600"><?= h(tr('Only people who saved that exact line can see the mutual link. There is no public list of users or of what people saved.')) ?></p>
        </div>
    </div>
</article>
