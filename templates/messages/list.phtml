<?php
/** @var array{id: mixed, messages: list<array{id: mixed, content: string, victims: list<array{id: mixed, username: string}>}>} $victim */
?>
<p class="text-sm font-semibold text-sky-700"><?= h(tr('Your feed')) ?></p>
<h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900"><?= h(tr('Everything you saved')) ?></h1>
<p class="mt-3 text-slate-600"><?= h(tr('If a line shows names, those people heard the same exact words.')) ?></p>
<p class="mt-4 text-sm text-slate-500"><?= h(tr('Profile ID:')) ?> <span class="font-mono text-slate-800"><?= h((string) $victim['id']) ?></span></p>

<h2 class="mt-10 text-sm font-semibold text-slate-900"><?= h(tr('Your entries')) ?></h2>
<?php if (!empty($victim['messages'])): ?>
    <ul class="mt-4 divide-y divide-slate-100 rounded-2xl border border-slate-200/80 bg-white shadow-sm">
        <?php foreach ($victim['messages'] as $message): ?>
            <li class="px-4 py-4">
                <p class="text-slate-800"><?= h($message['content']) ?></p>
                <?php
                $savedLabel = harness_format_saved_at($message['saved_at'] ?? null);
                if ($savedLabel !== ''): ?>
                    <p class="mt-1 text-xs text-slate-500"><?= h(tr('Saved at')) ?> <?= h($savedLabel) ?></p>
                <?php endif; ?>
                <?php if (count($message['victims'] ?? []) > 1): ?>
                    <div class="mt-2 flex flex-wrap items-center gap-2 text-sm">
                        <span class="text-slate-500"><?= h(tr('Linked victims:')) ?></span>
                        <?php foreach ($message['victims'] as $linked): ?>
                            <span class="rounded-full bg-sky-50 px-2.5 py-0.5 text-xs font-medium text-sky-900 ring-1 ring-sky-100"><?= h($linked['username']) ?></span>
                        <?php endforeach; ?>
                    </div>
                <?php endif; ?>
            </li>
        <?php endforeach; ?>
    </ul>
    <div class="mt-8 flex flex-wrap items-center gap-3">
        <a class="inline-flex rounded-xl bg-gradient-to-r from-sky-600 to-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-sky-600/20 hover:from-sky-500 hover:to-indigo-500" href="/messages/detail"><?= h(tr('Share another line')) ?></a>
        <a class="inline-flex rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" href="/messages/export" download><?= h(tr('Export a CSV')) ?></a>
    </div>
<?php else: ?>
    <div class="mt-5 flex flex-col items-center rounded-2xl border border-dashed border-slate-200 bg-slate-50/60 py-12 text-center">
        <p class="max-w-sm text-sm text-slate-600"><?= h(tr('You have not saved anything yet. Add the exact line you heard to get started.')) ?></p>
        <a class="mt-5 rounded-xl bg-gradient-to-r from-sky-600 to-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-sky-600/20 hover:from-sky-500 hover:to-indigo-500" href="/messages/detail"><?= h(tr('Share a line')) ?></a>
    </div>
<?php endif; ?>
