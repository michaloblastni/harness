    <p class="mt-2 text-sm text-slate-500"><?= h(tr('No shared phrases in the database (unexpected if you are linked).')) ?></p>
<?php else: ?>
    <ul class="mt-4 divide-y divide-slate-100 rounded-2xl border border-slate-200/80 bg-white shadow-sm">
        <?php foreach ($linked['shared_phrases'] as $row): ?>
            <li class="px-4 py-3 text-slate-800">
                <p><?= h($row['content']) ?></p>
                <?php
                $t = harness_format_saved_at($row['saved_at'] ?? null);
                if ($t !== ''): ?>
                    <p class="mt-1 text-xs text-slate-500"><?= h(tr('They saved at')) ?> <?= h($t) ?></p>
                <?php endif; ?>
            </li>
        <?php endforeach; ?>
    </ul>
<?php endif; ?>

<h2 class="mt-10 text-sm font-semibold text-slate-900"><?= h(tr('Their other notes')) ?></h2>
<p class="mt-2 text-sm text-slate-500"><?= h(tr('Everything they have saved. The list above shows the lines that linked you as victims.')) ?></p>
<?php if (empty($linked['their_phrases'])): ?>
    <p class="mt-2 text-sm text-slate-500"><?= h(tr('They have not recorded any other phrases yet.')) ?></p>
<?php else: ?>
    <ul class="mt-4 divide-y divide-slate-100 rounded-2xl border border-slate-200/80 bg-slate-50/50">
        <?php foreach ($linked['their_phrases'] as $row): ?>
            <li class="px-4 py-3 text-sm text-slate-700">
