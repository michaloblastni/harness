 */
?>
<p class="text-sm font-semibold text-sky-700"><?= h(tr('Linked victims')) ?></p>
<h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900"><?= h($linked['username']) ?></h1>

<div class="mt-8 rounded-2xl border border-slate-200/80 bg-gradient-to-br from-slate-50 to-sky-50/30 p-5 ring-1 ring-slate-900/[0.02]">
