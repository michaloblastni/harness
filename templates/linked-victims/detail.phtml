    <a class="mt-1 inline-block break-all font-semibold text-brand-700 hover:text-brand-900" href="mailto:<?= h($linked['email']) ?>?subject=<?= rawurlencode(tr('Harness — hello')) ?>"><?= h($linked['email']) ?></a>
